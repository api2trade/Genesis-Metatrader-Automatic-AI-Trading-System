# GENESIS Trading System — Environment Template
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this to .env and fill in your values:
#    cp .env.example .env
#
#  Or run the interactive setup wizard (recommended):
#    bash setup.sh
# ─────────────────────────────────────────────────────────────────────────────

# ── API2TRADE ─────────────────────────────────────────────────────────────────
# Sign up and get credentials: https://app.api2trade.com
# Cost: €12/month per connected MT5 account
#
# MT5_ACCOUNT_UUID  = The session UUID from your API2TRADE dashboard
#                     (created automatically when you connect your MT5 account)
# MT5_ACCOUNT_ID    = Same as above (alias used by some strategy modules)
# MT5_API_KEY       = Your API2TRADE API key
# MT5_API_USER      = Your API2TRADE username
# MT5_API_PASS      = Your API2TRADE password
# MT5_API_URL       = REST endpoint (do not change unless on MT4)

MT5_ACCOUNT_UUID=YOUR_API2TRADE_SESSION_UUID
MT5_ACCOUNT_ID=YOUR_API2TRADE_SESSION_UUID
MT5_API_KEY=YOUR_API2TRADE_API_KEY
MT5_API_USER=YOUR_API2TRADE_USERNAME
MT5_API_PASS=YOUR_API2TRADE_PASSWORD
MT5_API_URL=https://mt5.mt4api.dev

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot:    https://t.me/BotFather → /newbot
# Get your Chat ID: https://t.me/userinfobot

TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# ── OpenAI (Hermes LLM Brain) ─────────────────────────────────────────────────
# Powers the hourly macro analysis by Hermes
# Get key: https://platform.openai.com/api-keys
# Cost: ~$0.10–0.50/day for GPT-4o-mini

OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
HERMES_MODEL=gpt-4o-mini

# ── Risk Limits ───────────────────────────────────────────────────────────────
# These are enforced by every strategy module before any trade is placed.
# Hermes will refuse any trade that violates these limits.

MAX_POSITIONS=4       # Maximum simultaneous open positions
MAX_RISK_PCT=0.02     # Maximum risk per trade (2% of balance)
MAX_LOTS=3.0          # Maximum lot size per single trade

# ── Optional: Twelve Data ─────────────────────────────────────────────────────
# For economic calendar enrichment (news filter)
# Free tier: https://twelvedata.com

TWELVE_DATA_API_KEY=
